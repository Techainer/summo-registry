{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.summo.app/schema/manifest.schema.json",
  "title": "Summo model manifest",
  "description": "One file fully describing one model: where it lives, what it costs, and under what terms.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "task",
    "mode",
    "runtime",
    "license",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]{1,128}$",
      "description": "Also used as a path segment, hence the restricted character set."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "enum": [
        "asr",
        "vad",
        "denoise",
        "diarize-seg",
        "speaker-embed",
        "embed",
        "tts"
      ]
    },
    "mode": {
      "enum": [
        "live",
        "batch"
      ],
      "description": "live streams with constant cost per chunk; batch is driven by re-decoding a growing window."
    },
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "langs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ISO codes, or [\"*\"] for language-independent models."
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "attribution": {
      "type": "string"
    },
    "redistributable": {
      "type": "boolean",
      "default": true,
      "description": "false means Summo may not host these files; the manifest must point upstream."
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "description": {
      "type": "string"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rss_mb": {
          "type": "object",
          "properties": {
            "idle": {
              "type": "integer",
              "minimum": 0
            },
            "peak": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "vram_mb": {
          "type": "integer",
          "minimum": 0
        },
        "min_ram_mb": {
          "type": "integer",
          "minimum": 0
        },
        "rtf": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Real-time factor keyed by hardware class, e.g. cpu_x86_avx512vnni_8t."
        },
        "latency_ms": {
          "type": "object",
          "properties": {
            "first_partial": {
              "type": "integer",
              "minimum": 0
            },
            "finalize_p50": {
              "type": "integer",
              "minimum": 0
            },
            "finalize_p95": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Keyed by benchmark, e.g. wer_fleurs_vi. Language-specific keys are preferred when ranking."
        },
        "accel": {
          "type": "array",
          "items": {
            "enum": [
              "cpu",
              "cuda",
              "coreml",
              "metal",
              "vulkan",
              "directml"
            ]
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "sha256",
          "size",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[^/\\\\]+$",
            "description": "A bare file name; anything path-like is rejected."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "url": {
            "type": "string",
            "pattern": "^(https|file)://"
          },
          "mirror": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(https|file)://"
            }
          },
          "platform": {
            "type": "string",
            "description": "Restricts a file to one platform, e.g. linux-x64. Omit for portable files."
          },
          "archive": {
            "type": "string",
            "enum": [
              "tar-bz2",
              "tar-gz"
            ],
            "description": "Unpack this entry rather than using it as a file. The digest is still the digest of the archive's own bytes. For a model that is a directory — a piper voice is an .onnx plus several hundred phoneme tables the runtime opens by directory path."
          }
        }
      }
    },
    "params": {
      "type": "object",
      "description": "Runtime knobs. Values naming a file map that file to what the runtime expects — the only way to find anything in a content-addressed store."
    }
  }
}
